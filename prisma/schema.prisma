// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  modules      String   @default("[\"united-carpi\"]")
  createdAt    DateTime @default(now())

  // Profilo personale minimo (facoltativo): usato per mostrare un nome vero invece
  // dell'email in sidebar e come autore delle Considerazioni. accentColor sostituisce
  // solo il colore --accent (mai bg/pannelli/testo): null = arancione di default.
  nome         String?
  cognome      String?
  ruolo        String?
  accentColor  String?
  // Preferenza personale (come nome/cognome/ruolo, mai letta dal proprietario della squadra
  // per un collaboratore): scambia solo bg/pannelli/testo con una palette chiara, mai
  // --accent (quello resta il colore squadra scelto separatamente).
  temaChiaro   Boolean  @default(false)

  // Solo per integrità referenziale a livello di database (constraint FK): nessuna di
  // queste liste va mai attraversata a partire da uno User nel codice applicativo, che
  // continua a interrogare le singole tabelle filtrando per userId come già fa oggi.
  teamMembersOwned           TeamMember[]     @relation("TeamMemberOwner")
  teamMemberships            TeamMember[]     @relation("TeamMemberUser")
  kvEntries                  KvEntry[]
  stagioni                   Stagione[]
  categorie                  Categoria[]
  objectives                 Objective[]
  exercises                  Exercise[]
  sessions                   Session[]
  considerazioniProprietarie Considerazione[] @relation("ConsiderazioneOwner")
  considerazioniScritte      Considerazione[] @relation("ConsiderazioneAutore")
  noteScritte                Note[]

  @@map("users")
}

// Un collaboratore invitato dall'admin (l'utente proprietario di userId=ownerId) a lavorare
// sulla stessa squadra. Nessuna migrazione dei dati esistenti: rosa/calendario/esercizi/ecc.
// restano scoped da userId come sempre — un collaboratore "vede" i dati della squadra perché
// la sessione risolve il suo id personale all'ownerId (vedi lib/dal.js getSession). Revoca
// SEMPRE soft (revokedAt), mai DELETE: i colori si assegnano in base al conteggio dei membri,
// un DELETE farebbe slittare/collidere i colori di chi resta o arriva dopo.
// permissions: array JSON di chiavi granulari (vedi lib/permissions.js PERMISSIONS), scelte
// individualmente dall'admin per questo invito — non un ruolo preimpostato. Mai una FK/enum:
// validazione solo lato applicazione contro l'elenco canonico.
model TeamMember {
  id              String    @id @default(cuid())
  ownerId         String
  userId          String?
  email           String
  permissions     String    @default("[]")
  colore          String
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime  @default(now())
  joinedAt        DateTime?
  revokedAt       DateTime?

  owner User  @relation("TeamMemberOwner", fields: [ownerId], references: [id])
  user  User? @relation("TeamMemberUser", fields: [userId], references: [id])

  @@map("team_members")
}

// stagioneId è '' (non null: SQLite/Prisma non ammettono null dentro una compound unique
// key usata con findUnique/upsert) per le chiavi non legate a una squadra (es.
// sidebar-order, una preferenza personale dell'account); per tutto il resto (rosa,
// calendario, formazione predefinita, piano squadra) è l'id della Stagione a cui quel
// blob appartiene.
model KvEntry {
  id         String   @id @default(cuid())
  userId     String?
  stagioneId String   @default("")
  key        String
  value      String
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@unique([userId, stagioneId, key])
  @@map("kv_entries")
}

// Una Stagione rappresenta la squadra/categoria allenata in un dato periodo (es. "2026/27
// — Mirandolese, Juniores Regionale"). Rosa/calendario/formazione predefinita/piano squadra
// sono sempre agganciati alla stagione attiva; la libreria Schema (esercizi/etichette) NON
// è scopata per stagione, resta condivisa. Chiudere una stagione crea la successiva attiva
// e lascia quella vecchia consultabile in sola lettura come archivio.
model Stagione {
  id          String    @id @default(cuid())
  userId      String
  etichetta   String
  societa     String
  tipoSquadra String
  livello     String
  attiva      Boolean   @default(true)
  creataIl    DateTime  @default(now())
  chiusaIl    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("stagioni")
}

// Fase di allenamento (riscaldamento, tattica, ecc.): scelta vincolata per Exercise.categoria
// ma personalizzabile per account, non più una lista fissa nel codice — l'allenatore può
// rinominarle, ricolorarle, eliminarle o crearne di nuove dalla libreria esercizi.
model Categoria {
  id     String @id @default(cuid())
  userId String
  chiave String
  label  String
  color  String
  ordine Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chiave])
  @@map("categorie")
}

model Objective {
  id            String @id @default(cuid())
  userId        String
  key           String
  label         String
  order         Int    @default(0)
  categoria     String @default("fisico") // "fisico" | "tecnico-tattico"
  rpeSuggerito  Int? // 1-10 (scala Borg CR10), solo indicativo per categoria "fisico"
  loadMin       Float
  loadMax       Float

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@map("objectives")
}

// Un esercizio è un'identità (titolo, dimensioni, etichette); il contenuto vero e proprio
// (disegno, descrizione, ripetizioni/durata/recupero) vive nei suoi Livelli. Un esercizio
// senza progressione ha semplicemente un solo Livello ("A"); una progressione A/B/C è lo
// stesso esercizio con più livelli, non esercizi diversi.
model Exercise {
  id                  String   @id @default(cuid())
  userId              String
  descrizione         String   @default("")
  tags                String   @default("[]")
  // Fasi di gioco a scelta vincolata (non un'etichetta libera): JSON array di "chiave" di
  // Categoria, stesso pattern di tags — un esercizio può appartenere a più fasi insieme
  // (es. sia "Costruzione dal basso" sia "Transizioni positive"). "[]" = non categorizzato.
  categorie           String   @default("[]")
  // Preferenza personale dell'allenatore su quanto reputa efficace l'esercizio (1-5): un
  // singolo valore che si sovrascrive, non una media di più voti nel tempo — l'efficacia
  // percepita in una singola seduta dipenderebbe da troppi fattori estranei all'esercizio
  // in sé (avversario, condizione dei giocatori, meteo...).
  votoPreferenza      Int?
  // Difficoltà percepita dell'esercizio (1-5): campo NUOVO e SEPARATO da votoPreferenza —
  // "quanto è difficile" e "quanto lo reputo efficace" sono giudizi indipendenti, mai lo
  // stesso numero riletto due volte. Riusa lo stesso componente grafico a stelle.
  difficolta          Int?
  creatoIl            DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id])
  livelli Livello[]
  note    Note[]

  @@map("exercises")
}

model Livello {
  id                String @id @default(cuid())
  esercizioId       String
  nome              String @default("A")
  ordine            Int    @default(0)
  descrizione       String @default("")
  schemaCampo       String @default("{}")
  ripetizioni       Int    @default(1)
  durataRipetizione Int    @default(15)
  recuperoSecondi   Int    @default(0)
  // Spostati qui da Exercise: ogni livello di progressione ha il proprio titolo e la propria
  // messa in campo (giocatori, dimensioni), modificabili senza incidere sugli altri livelli
  // dello stesso esercizio — solo tags/categorie/votoPreferenza restano condivisi a livello
  // di Exercise (metadati di famiglia, non della singola progressione).
  titolo              String @default("")
  // Giocatori di movimento; i portieri sono un conteggio separato (numeroPortieri) invece
  // di essere sommati qui dentro, cosi la scheda esercizio può mostrare "8+1" invece di un
  // solo "9" che non distingue i ruoli.
  numeroGiocatoriBase Int    @default(8)
  numeroPortieri      Int    @default(0)
  larghezzaCampo      Float  @default(20)
  lunghezzaCampo      Float  @default(28)
  // Esercizi puramente descrittivi non hanno bisogno del disegno campo: disattivandolo si
  // risparmia spazio nel foglio stampato/esportato, senza perdere schemaCampo (resta salvato,
  // solo non mostrato finché non si riattiva).
  mostraDisegno       Boolean @default(true)
  // Vocabolario chiuso, NON personalizzabile dall'utente (a differenza di Exercise.categorie):
  // 'analitico' | 'situazionale' | 'globale' | 'preparazione_atletica'. Null = non specificato,
  // finisce nel bucket "non categorizzato" nelle statistiche come le fasi senza categoria.
  // Varia per progressione (come numeroGiocatoriBase): un esercizio può iniziare analitico nel
  // livello A e diventare situazionale/globale nei livelli successivi.
  tipoEsercitazione   String?

  esercizio    Exercise      @relation(fields: [esercizioId], references: [id], onDelete: Cascade)
  sessionItems SessionItem[]

  @@map("livelli")
}

model Note {
  id          String   @id @default(cuid())
  esercizioId String
  sedutaId    String?
  testo       String
  data        DateTime @default(now())
  autoreId    String?
  autoreNome  String?

  esercizio Exercise @relation(fields: [esercizioId], references: [id], onDelete: Cascade)
  autore    User?    @relation(fields: [autoreId], references: [id], onDelete: SetNull)

  @@map("notes")
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  titolo        String
  obiettivoId   String?
  allenamentoId String?
  rpe           Int? // 1-10, intensità percepita dell'intera seduta (session-RPE, Foster)
  creataIl      DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id])
  items           SessionItem[]
  blocchi         SessionBlock[]
  considerazioni  Considerazione[]

  @@map("sessions")
}

// Blocco di lavoro parallelo: N esercizi (uno per "gruppo") svolti nello stesso momento
// invece che in sequenza. Non ha un proprio campo ordine: la sua posizione nella seduta è
// quella (contigua) dei SessionItem che vi appartengono — vedi SessionItem.blockId/gruppo.
// "invertono" segnala che i gruppi si scambiano a metà seduta (il tempo di lavoro raddoppia
// nel calcolo del totale, senza duplicare le righe in stampa — vedi withComputed in
// app/api/schema/sessions/[id]/route.js).
model SessionBlock {
  id        String  @id @default(cuid())
  sessionId String
  invertono Boolean @default(false)

  session Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items   SessionItem[]

  @@map("session_blocks")
}

// Rimpiazza il vecchio Session.note (un solo blocco di testo, implicitamente scritto
// dall'allenatore): ora una lista, ciascuna firmata da chi l'ha scritta realmente
// (autoreId = session.actorUserId, non session.userId che è sempre lo scope squadra) e col
// suo colore. sedutaId nullable rispecchia lo stesso pattern già usato da Note.sedutaId per
// gli esercizi: null = considerazione generica/aperta, valorizzato = legata a una seduta.
// Il colore NON è salvato qui (si risolve dal vivo dal roster, vedi lib/team.js): un colore
// per persona, mai duplicato per nota, altrimenti due fonti di verità che possono disallinearsi.
model Considerazione {
  id         String   @id @default(cuid())
  ownerId    String
  autoreId   String
  autoreNome String
  sedutaId   String?
  testo      String
  creataIl   DateTime @default(now())
  // "pre" = scritta componendo la seduta, va in cima al foglio (contesto/obiettivi/partita
  // precedente); "post" = scritta dopo (dall'allenatore o dai collaboratori) su cosa si è
  // visto, resta in fondo come oggi. Solo rilevante per considerazioni legate a una seduta;
  // quelle generiche (sedutaId null) restano "post" di default ma non vengono mai lette.
  momento    String   @default("post")

  owner  User     @relation("ConsiderazioneOwner", fields: [ownerId], references: [id])
  autore User     @relation("ConsiderazioneAutore", fields: [autoreId], references: [id])
  seduta Session? @relation(fields: [sedutaId], references: [id], onDelete: SetNull)

  @@map("considerazioni")
}

// livelloId è facoltativo (SetNull): un esercizio/livello può essere eliminato dalla libreria
// anche se usato in una seduta passata. titoloSnapshot/livelloSnapshot congelano il nome
// visto al momento dell'inserimento, così la seduta resta leggibile come "immagine" storica
// anche se la fonte viene poi cancellata.
model SessionItem {
  id              String  @id @default(cuid())
  sessionId       String
  livelloId       String?
  titoloSnapshot  String
  livelloSnapshot String
  ordine          Int     @default(0)
  durataMinuti    Int?
  // Se valorizzato, l'item fa parte di un blocco di lavoro parallelo (blockId) nella
  // posizione "gruppo" (1, 2, 3...) tra quelli che lavorano nello stesso momento. Gli item
  // dello stesso blocco devono avere ordine contiguo: la UI li raggruppa camminando la
  // lista ordinata per ordine e accorpando le righe consecutive con lo stesso blockId.
  blockId         String?
  gruppo          Int?

  session Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  livello Livello?      @relation(fields: [livelloId], references: [id], onDelete: SetNull)
  blocco  SessionBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@map("session_items")
}

// Iscrizione alla lista d'attesa dalla landing page pubblica (nessun account creato qui:
// vedi app/api/waitlist/route.js). Attivazione rigorosamente cronologica su createdAt, mai
// per priorità soggettiva — coerente col posizionamento "semplice, per tutti".
model WaitlistSignup {
  id                  String   @id @default(cuid())
  email               String   @unique
  ruolo               String // "allenatore" | "dirigente" | "collaboratore-staff"
  categoria           String
  numeroCollaboratori Int
  createdAt           DateTime @default(now())

  @@map("waitlist_signups")
}

// Tentativo di login fallito (email sbagliata o password sbagliata), usato per bloccare
// temporaneamente il login sulla stessa email dopo troppi fallimenti ravvicinati
// (protezione da brute-force). Nessuna relazione con User: un'email inesistente deve
// comunque poter essere registrata come tentativo. Le righe vecchie restano nel tempo
// ma non vengono mai lette oltre la finestra di blocco (vedi loginAction).
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}
